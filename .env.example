# Copy this file to .env and fill in your actual values. Never commit .env to git.

DISCORD_TOKEN=your_discord_bot_token_here

# How often (in seconds) the bot checks tracked wallets for new activity
POLL_INTERVAL_SECONDS=180

ALCHEMY_API_KEY=
HELIUS_API_KEY=

# Max wallets a single Discord user can track
MAX_WALLETS_PER_USER=10

# Points the SQLite file at a persistent volume mount when deployed
# (e.g. on Railway: DB_PATH=/data/tracker.db). Leave unset for local dev.
DB_PATH=

# Port for the healthcheck HTTP server (Railway sets this automatically
# for web-exposed services)
PORT=8080
